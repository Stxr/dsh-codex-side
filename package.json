{
  "name": "@local/dsh-codex-side",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "description": "Codex-style side conversations for DeepSeek Harness",
  "license": "MIT",
  "author": "Stxr",
  "homepage": "https://github.com/Stxr/dsh-codex-side#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stxr/dsh-codex-side.git"
  },
  "bugs": {
    "url": "https://github.com/Stxr/dsh-codex-side/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "side-conversation"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "main": "./runtime/1.4.3/index.js",
  "types": "./runtime/1.4.3/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./runtime/1.4.3/types/host/index.d.ts",
      "default": "./runtime/1.4.3/index.js"
    },
    "./client": "./runtime/1.4.3/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "runtime/1.4.3/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "tsconfig.build.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "RELEASING.md",
    "ARCHITECTURE.md",
    "VERIFICATION.md",
    "LICENSE",
    "test/"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "index:build": "tsx scripts/build-index.ts",
    "index:check": "tsx scripts/check-index.ts",
    "test": "tsx scripts/test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.2.2-rc.1",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.2-rc.1",
    "@types/node": "24.10.0",
    "@types/react": "19.1.16",
    "esbuild": "0.25.12",
    "react": "19.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
