{
  "name": "@local/dsh-codex-side",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Codex-style side conversations for DeepSeek Harness",
  "license": "MIT",
  "author": "Stxr",
  "homepage": "https://github.com/Stxr/dsh-codex-side#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stxr/dsh-codex-side.git"
  },
  "bugs": {
    "url": "https://github.com/Stxr/dsh-codex-side/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "codex", "side-conversation"],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./runtime/1.4.2/index.js",
    "./client": "./runtime/1.4.2/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "workspace-adapter.js",
    "title.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "RELEASING.md",
    "LICENSE",
    "runtime/1.4.2/*.js",
    "scripts/*.mjs",
    "test/*.test.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "index:build": "node scripts/build-index.mjs",
    "index:check": "node scripts/check-index.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js && node --check workspace-adapter.js && node --check title.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.2.2-rc.1",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.1"
  }
}
